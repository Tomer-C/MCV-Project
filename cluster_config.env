# cluster_config.env
MASTER_PORT=29500

# Project Path on all servers
PROJECT_PATH=/home/[USERNAME]/[PROJECT_DIR]

# Node 0
NODE_0_IP=[NODE_0_IP]
NODE_0_USER=[USERNAME]
NODE_0_KEY=~/.ssh/id_rsa

# Node 1
NODE_1_IP=[NODE_1_IP]
NODE_1_USER=[USERNAME]
NODE_1_KEY=~/.ssh/id_rsa

# Node 2
NODE_2_IP=[NODE_2_IP]
NODE_2_USER=[USERNAME]
NODE_2_KEY=~/.ssh/id_rsa

# Node 3
NODE_3_IP=[NODE_3_IP]
NODE_3_USER=[USERNAME]
NODE_3_KEY=~/.ssh/id_rsa

# Node 4
NODE_4_IP=[NODE_4_IP]
NODE_4_USER=[USERNAME]
NODE_4_KEY=~/.ssh/id_rsa
